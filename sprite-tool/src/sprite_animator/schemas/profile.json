{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "animation", "frames", "duration_ms", "tracks"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "animation": {"const": "walk"},
    "frames": {"enum": [6, 8]},
    "duration_ms": {"type": "integer", "minimum": 10, "maximum": 65530, "multipleOf": 10},
    "tracks": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {
        "type": "array", "minItems": 6, "maxItems": 8,
        "items": {"$ref": "#/$defs/step"}
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "offset": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": -512, "maximum": 512}},
        "pose": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      }
    }
  }
}
